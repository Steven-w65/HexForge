{
  "version": 1,
  "name": "PNG Header (IHDR)",
  "defaultEndianness": "big",
  "fields": [
    {
      "name": "signature",
      "offset": "0",
      "type": "bytes",
      "length": 8,
      "comment": "PNG file signature; expected 89 50 4E 47 0D 0A 1A 0A."
    },
    {
      "name": "ihdrLength",
      "offset": "8",
      "type": "u32",
      "comment": "IHDR data length; expected 13 bytes."
    },
    {
      "name": "chunkType",
      "offset": "12",
      "type": "string",
      "length": 4,
      "comment": "First chunk type; expected IHDR."
    },
    {
      "name": "width",
      "offset": "16",
      "type": "u32",
      "comment": "Image width in pixels."
    },
    {
      "name": "height",
      "offset": "20",
      "type": "u32",
      "comment": "Image height in pixels."
    },
    {
      "name": "bitDepth",
      "offset": "24",
      "type": "u8",
      "comment": "Bits per sample or palette index."
    },
    {
      "name": "colorType",
      "offset": "25",
      "type": "u8",
      "comment": "0 grayscale, 2 truecolor, 3 indexed, 4 grayscale with alpha, 6 truecolor with alpha."
    },
    {
      "name": "compressionMethod",
      "offset": "26",
      "type": "u8",
      "comment": "Compression method; 0 is the PNG-defined method."
    },
    {
      "name": "filterMethod",
      "offset": "27",
      "type": "u8",
      "comment": "Filter method; 0 is the PNG-defined method."
    },
    {
      "name": "interlaceMethod",
      "offset": "28",
      "type": "u8",
      "comment": "0 means none; 1 means Adam7 interlace."
    },
    {
      "name": "ihdrCrc",
      "offset": "29",
      "type": "u32",
      "comment": "Stored IHDR CRC. This template displays but does not verify it."
    }
  ]
}
