{
  "binary": { "name": "parity.bin", "length": 16000, "pattern": "byte-index-mod-256" },
  "scenes": [
    { "name": "empty", "surface": "main" },
    { "name": "file-menu", "surface": "main", "menu": "file" },
    { "name": "edit-menu", "surface": "main", "menu": "edit" },
    { "name": "navigate-menu", "surface": "main", "menu": "navigate" },
    { "name": "template-menu", "surface": "main", "menu": "template" },
    { "name": "view-menu", "surface": "main", "menu": "view" },
    { "name": "minimap-menu", "surface": "main", "menu": "view", "flyout": "minimap" },
    { "name": "results-menu", "surface": "main", "binary": "parity.bin", "template": "structures.json", "apply": true, "menu": "navigate", "flyout": "results" },
    { "name": "busy", "surface": "main", "busy": true },
    { "name": "error", "surface": "main", "error": true },
    { "name": "editor-empty", "surface": "editor" },
    { "name": "editor-advanced", "surface": "editor", "template": "structures.json" },
    { "name": "editor-dirty", "surface": "editor", "template": "structures.json", "editorName": "Edited preview" },
    { "name": "editor-invalid", "surface": "editor", "template": "structures.json", "editorName": "" },
    { "name": "editor-close", "surface": "editor", "template": "structures.json", "editorName": "Edited preview", "editorClose": true },
    { "name": "editor-save-error", "surface": "editor", "template": "structures.json", "editorName": "Edited preview", "editorClose": true, "saveError": true },
    { "name": "open", "surface": "main", "binary": "parity.bin" },
    { "name": "open-32", "surface": "main", "binary": "parity.bin", "bytesPerRow": 32 },
    { "name": "empty-file", "surface": "main", "binary": "empty.bin" },
    { "name": "edited", "surface": "main", "binary": "parity.bin", "edit": { "offset": 128, "value": 255 } },
    { "name": "binary-close", "surface": "main", "binary": "parity.bin", "edit": { "offset": 128, "value": 255 }, "closeBinary": true },
    { "name": "search", "surface": "main", "binary": "parity.bin", "search": "41 42 43" },
    { "name": "goto", "surface": "main", "binary": "parity.bin", "goto": "0x100" },
    { "name": "pending-template", "surface": "main", "binary": "parity.bin", "template": "structures.json" },
    { "name": "selected-field", "surface": "main", "binary": "parity.bin", "template": "structures.json", "apply": true, "selectedPath": "entries[2].id" },
    { "name": "cleared-field", "surface": "main", "binary": "parity.bin", "template": "structures.json", "apply": true, "selectedPath": "entries[2].id", "clearSelection": 128 },
    { "name": "results-diagnostics", "surface": "main", "binary": "parity.bin", "template": "diagnostics.json", "apply": true },
    { "name": "results-tree-focus", "surface": "main", "binary": "parity.bin", "template": "structures.json", "apply": true, "focusResult": "header.signature" },
    { "name": "fit-top", "surface": "main", "binary": "parity.bin", "mode": "fit", "navigateRow": 0 },
    { "name": "fit-middle", "surface": "main", "binary": "parity.bin", "mode": "fit", "navigateRow": 500 },
    { "name": "fit-eof", "surface": "main", "binary": "parity.bin", "mode": "fit", "navigateRow": 999 },
    { "name": "proportional-top", "surface": "main", "binary": "parity.bin", "mode": "proportional", "navigateRow": 0 },
    { "name": "proportional-middle", "surface": "main", "binary": "parity.bin", "mode": "proportional", "navigateRow": 500 },
    { "name": "proportional-eof", "surface": "main", "binary": "parity.bin", "mode": "proportional", "navigateRow": 999 }
  ]
}
